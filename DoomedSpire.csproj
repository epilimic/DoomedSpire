<Project Sdk="Microsoft.NET.Sdk">

  <!-- TEMPLATE, NOT COMPILED. Same ideas as BingBongBuddy.csproj (known to build), with the game paths coming from Sts2PathDiscovery.props.
       Your own paths go in Directory.Build.props (git-ignored; MSBuild loads it by itself, before this file). -->
  <Import Project="Sts2PathDiscovery.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>DoomedSpire</AssemblyName>
    <RootNamespace>DoomedSpire</RootNamespace>
    <!-- No <Version> here on purpose: the version lives only in DoomedSpire.json. bash workshop/versions.sh flags a <Version> that disagrees with it. -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Keeps your folder names out of the dll: the compiler records source and debug-file paths, and this rewrites them to relative ones
         (the same two lines as the Godot-export build). workshop/scrub.py stops an upload if a path still gets through. -->
    <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
    <PathMap>$(AppOutputBase)=.\</PathMap>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Test projects live in tests/ and are not part of the mod: keep their .cs files (and generated obj/ files) out of the dll. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- The game's own assemblies. Private=false so they are NOT copied next to the mod's dll. Add Steamworks.NET.dll etc. only when the code needs them. -->
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Files baked into the dll (keep the mod folder to the dll + manifest only: the game treats EVERY .json in a mod folder as a manifest). -->
  <ItemGroup>
    <!-- Pictures: put them in assets/ and uncomment (see solutions/embedded-art): <EmbeddedResource Include="assets/**/*.png;assets/**/*.webp" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" /> -->
    <!-- DOOM's built-in game data (the shareware DOOM1.WAD, embedded unmodified) and its license notice, see assets/doom/README.md. Written to disk the first time DOOM opens (src/BuiltInWad.cs). -->
    <EmbeddedResource Include="assets/doom/doom1.wad" LogicalName="doom1.wad" />
    <EmbeddedResource Include="assets/doom/LICENSE.txt" LogicalName="doom1-LICENSE.txt" />

    <!-- DOOM's music is played with this soundfont (GPL-2), see assets/soundfont/README.md. Read straight from the dll by the synthesizer. -->
    <EmbeddedResource Include="assets/soundfont/TimGM6mb.sf2" LogicalName="TimGM6mb.sf2" />
    <EmbeddedResource Include="assets/soundfont/LICENSE.txt" LogicalName="TimGM6mb-LICENSE.txt" />
  </ItemGroup>

  <Target Name="CheckSts2Paths" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')"
           Text="Cannot find sts2.dll in '$(Sts2DataDir)'. Put Sts2Path (the game folder) in Directory.Build.props." />
  </Target>

  <!-- dotnet build AND dotnet publish both leave the mod installed in the game's mods folder. -->
  <Target Name="InstallMod" AfterTargets="Build">
    <MakeDir Directories="$(ModsPath)$(MSBuildProjectName)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;$(MSBuildProjectName).json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)" />
  </Target>

  <!-- dotnet publish also stages exactly the two files a Workshop upload needs straight into workshop/content (nothing stale is left there). -->
  <Target Name="StageWorkshop" AfterTargets="Publish" DependsOnTargets="InstallMod">
    <ItemGroup>
      <OldStaged Include="$(MSBuildProjectDirectory)/workshop/content/**/*" Exclude="$(MSBuildProjectDirectory)/workshop/content/.gitkeep" />
    </ItemGroup>
    <Delete Files="@(OldStaged)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/workshop/content" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;$(MSBuildProjectName).json" DestinationFolder="$(MSBuildProjectDirectory)/workshop/content" />
    <Message Importance="high" Text="Staged for the Workshop: workshop/content (dll + json). Next: bash workshop/upload.sh, or bash workshop/release.sh for the whole release." />
  </Target>

</Project>
